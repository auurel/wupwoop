# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Initial Admin (for seed)
SEED_ADMIN_EMAIL="admin@muzayyan.com"
SEED_ADMIN_PASSWORD="Admin@123456"

# Cloudinary (image upload)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Optional: Google Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXXXX"

# Email / SMTP (Gmail App Password recommended)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="Muzayyan Admin <yourgmail@gmail.com>"

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER="628xxxxxxxxx"
